<!DOCTYPE html>
<html lang="vi" class="h-full">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Báo Cáo Đồ Án HTQTQTNV – FPT Long Châu (Thuyết Trình Toàn Diện)</title>
  
  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  
  <!-- Font Awesome 6 CDN -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  
  <!-- Slide Custom CSS -->
  <link rel="stylesheet" href="css/slide.css">
  <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220%22><text y=%2226%22 font-size=%2226%22>💊</text></svg>">
</head>
<body class="h-full bg-slate-950 text-slate-100 flex flex-col justify-between select-none overflow-hidden">

  <!-- Top Neon Loading Line (like YouTube/GitHub) -->
  <div id="top-loading-line" class="fixed top-0 left-0 h-[3px] bg-gradient-to-r from-blue-500 via-cyan-400 to-emerald-400 z-50 transition-all duration-300 pointer-events-none shadow-[0_0_12px_rgba(56,189,248,0.9)]" style="width: 1.78%;"></div>

  <!-- TOP HEADER / CONTROL BAR -->
  <header id="presentation-header" class="fixed top-0 inset-x-0 z-40 h-14 bg-slate-950/90 backdrop-blur-md border-b border-white/10 px-5 flex items-center justify-between transition-transform duration-300 shadow-lg">
    <!-- Brand / Class Info -->
    <div class="flex items-center gap-3">
      <div class="w-8 h-8 rounded-lg bg-blue-600 flex items-center justify-center text-white font-black text-sm shadow">
        LC
      </div>
      <div>
        <span class="text-xs font-bold text-slate-200 tracking-wide uppercase">IE203.F33.CN2.CNTT</span>
        <span class="text-[11px] text-slate-400 hidden lg:inline"> | Đồ án HTQTQTNV FPT Long Châu</span>
      </div>
    </div>

    <!-- Center Loading Progress Bar -->
    <div id="slide-progress-wrapper" class="flex items-center gap-2.5 sm:gap-3 relative select-none">
      <div id="slide-progress-track" class="relative w-28 sm:w-52 md:w-64 lg:w-80 xl:w-96 h-2.5 bg-slate-900/90 rounded-full border border-slate-700/80 cursor-pointer overflow-hidden group shadow-inner" title="Nhấp trên thanh để chuyển nhanh slide">
        <div id="slide-progress-fill" class="h-full rounded-full bg-gradient-to-r from-blue-500 via-cyan-400 to-emerald-400 relative transition-all duration-300" style="width: 1.78%;">
          <div class="progress-shimmer"></div>
        </div>
      </div>
      <div class="flex items-center font-mono text-xs">
        <span id="slide-progress-percent" class="font-bold text-cyan-300 min-w-[34px] text-right">2%</span>
      </div>
      <div id="slide-progress-tooltip" class="absolute -bottom-8 left-1/2 -translate-x-1/2 pointer-events-none opacity-0 transition-opacity duration-150 bg-slate-900/95 text-cyan-300 text-[11px] font-mono font-bold px-2.5 py-1 rounded-md border border-cyan-500/50 whitespace-nowrap shadow-2xl z-50">
        Slide 01: Bìa Đồ Án
      </div>
    </div>

    <!-- Quick Jump Selector -->
    <div class="hidden sm:flex items-center gap-2">
      <select id="slide-jump-select" class="bg-slate-900 border border-slate-700 text-slate-300 text-xs rounded-lg px-2.5 py-1 focus:outline-none focus:border-cyan-400">
        <!-- Options populated by JS -->
      </select>
    </div>

    <!-- Right Controls -->
    <div class="flex items-center gap-3">
      <!-- Timer -->
      <div id="timer-badge" class="flex items-center gap-2 bg-slate-800/80 border border-slate-700/80 hover:border-cyan-400/50 px-3 py-1 rounded-full text-xs font-mono font-bold text-cyan-300 cursor-pointer transition-colors" title="Nhấp để Chạy/Dừng đồng hồ (Phím T)">
        <i id="timer-status-icon" class="fa-solid fa-play text-[10px]"></i>
        <span id="timer-display">20:00</span>
        <button id="timer-reset-btn" class="text-slate-400 hover:text-white ml-1 text-[10px]" title="Reset thời gian"><i class="fa-solid fa-rotate-right"></i></button>
      </div>

      <!-- Fullscreen Button -->
      <!-- Theme Toggle Button (Light/Dark Mode) -->
      <button id="btn-toggle-theme" class="w-8 h-8 rounded-lg bg-slate-800 border border-slate-700 hover:bg-slate-700 text-slate-300 hover:text-amber-300 flex items-center justify-center text-xs transition-colors" title="Chuyển chế độ Sáng / Tối">
        <i id="theme-icon" class="fa-solid fa-sun"></i>
      </button>

      <!-- Toggle Header (Hide/Show) Button -->
      <button id="btn-toggle-header" class="w-8 h-8 rounded-lg bg-slate-800 border border-slate-700 hover:bg-cyan-600 hover:border-cyan-400 text-slate-300 hover:text-white flex items-center justify-center text-xs transition-all" title="Thu gọn thanh công cụ để mở rộng slide (Phím H)">
        <i id="header-toggle-icon" class="fa-solid fa-chevron-up"></i>
      </button>

      <button id="btn-fullscreen" class="w-8 h-8 rounded-lg bg-slate-800 border border-slate-700 hover:bg-slate-700 text-slate-300 hover:text-white flex items-center justify-center text-xs transition-colors" title="Toàn màn hình (Phím F)">
        <i class="fa-solid fa-expand"></i>
      </button>

      <!-- Slide Counter -->
      <span id="slide-counter" class="text-xs font-mono font-bold text-slate-400 px-2 py-1 bg-slate-900 border border-slate-800 rounded">
        01 / 59
      </span>
    </div>
  </header>

  <!-- Floating Reveal Tab to Restore Header When Hidden -->
  <div id="header-reveal-tab" class="fixed top-0 left-1/2 -translate-x-1/2 z-50 -translate-y-full transition-transform duration-300 pointer-events-auto">
    <button id="btn-show-header" class="px-4 py-1.5 rounded-b-xl bg-slate-900/95 hover:bg-cyan-600 text-cyan-300 hover:text-white text-xs font-mono font-bold border border-t-0 border-cyan-500/40 shadow-2xl flex items-center gap-2 backdrop-blur transition-all" title="Hiện thanh công cụ (Phím H)">
      <i class="fa-solid fa-chevron-down text-[10px]"></i>
      <span>Hiện thanh điều khiển</span>
    </button>
  </div>

  <!-- SLIDES VIEWPORT CANVAS -->
  <main class="slide-viewport">

    

    <!-- SLIDE 1 -->
    <section class="slide active bg-gradient-to-br from-slate-950 via-blue-950/60 to-slate-950" data-slide="1">
      <div class="slide-inner">
        <div class="flex flex-wrap items-center gap-3 mb-4">
          <span class="px-4 py-1.5 rounded-full text-xs sm:text-sm font-bold uppercase tracking-wider bg-blue-600/30 text-cyan-300 border border-cyan-400/30">
            Học phần: Hệ thống Quản trị Quy trình Nghiệp vụ (BPM)
          </span>
          <span class="px-4 py-1.5 rounded-full text-xs sm:text-sm font-mono font-bold bg-slate-800/80 text-amber-300 border border-amber-400/30">
            LỚP: IE203.F33.CN2.CNTT
          </span>
        </div>

        <h1 class="text-4xl sm:text-6xl font-black tracking-tight text-white leading-tight mb-4">
          BÁO CÁO ĐỒ ÁN MÔN HỌC<br/>
          <span class="text-transparent bg-clip-text bg-gradient-to-r from-cyan-300 via-sky-200 to-blue-400">
            HỆ THỐNG QUẢN TRỊ QUY TRÌNH NGHIỆP VỤ
          </span>
        </h1>
        <p class="text-slate-300 text-lg sm:text-2xl font-medium mb-8">
          Đề tài: HỆ THỐNG QUẢN TRỊ QUY TRÌNH NGHIỆP VỤ <strong class="text-white underline decoration-cyan-400 underline-offset-4">TẠI CÔNG TY CỔ PHẦN DƯỢC PHẨM FPT LONG CHÂU</strong>
        </p>

        <!-- Instructor & Team Cards Grid -->
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
          <div class="glass-card p-7 rounded-2xl border-l-4 border-amber-400 flex flex-col justify-center">
            <span class="text-xs uppercase tracking-wider font-bold text-amber-300 block mb-2">
              <i class="fa-solid fa-chalkboard-user mr-1.5"></i> Giảng viên hướng dẫn
            </span>
            <h3 class="text-2xl font-black text-white">ThS. Hà Lê Hoài Trung</h3>
            <p class="text-sm text-slate-400 mt-1.5">Khoa Khoa học và Kỹ thuật Thông tin - UIT</p>
          </div>

          <div class="glass-card p-7 rounded-2xl lg:col-span-2">
            <span class="text-xs uppercase tracking-wider font-bold text-cyan-300 block mb-4 flex items-center justify-between">
              <span><i class="fa-solid fa-users mr-1.5"></i> Sinh viên thực hiện (Nhóm Đề tài)</span>
              <span class="text-xs font-mono text-slate-400">6 Thành viên</span>
            </span>
            
            <div class="grid grid-cols-2 sm:grid-cols-3 gap-3.5 text-sm">
              <div class="p-3.5 rounded-xl bg-slate-900/80 border border-white/5">
                <span class="font-bold text-white block text-base">Huỳnh Công Hậu</span>
                <span class="font-mono text-cyan-400 text-xs">MSSV: 25210099</span>
              </div>
              <div class="p-3.5 rounded-xl bg-slate-900/80 border border-white/5">
                <span class="font-bold text-white block text-base">Nguyễn Đức Nhiên</span>
                <span class="font-mono text-cyan-400 text-xs">MSSV: 25210160</span>
              </div>
              <div class="p-3.5 rounded-xl bg-slate-900/80 border border-white/5">
                <span class="font-bold text-white block text-base">Nguyễn Thế Trụ</span>
                <span class="font-mono text-cyan-400 text-xs">MSSV: 25210226</span>
              </div>
              <div class="p-3.5 rounded-xl bg-slate-900/80 border border-white/5">
                <span class="font-bold text-white block text-base">Phan Duy An</span>
                <span class="font-mono text-cyan-400 text-xs">MSSV: 25210247</span>
              </div>
              <div class="p-3.5 rounded-xl bg-slate-900/80 border border-white/5">
                <span class="font-bold text-white block text-base">Trịnh Chí Nguyên</span>
                <span class="font-mono text-cyan-400 text-xs">MSSV: 25210150</span>
              </div>
              <div class="p-3.5 rounded-xl bg-slate-900/80 border border-white/5">
                <span class="font-bold text-white block text-base">Ngô Quốc Chung</span>
                <span class="font-mono text-cyan-400 text-xs">MSSV: 24730180</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ==================== LỜI MỞ ĐẦU ==================== -->

    <!-- SLIDE 2 -->

    <!-- SLIDE 2 -->

    <!-- SLIDE 2 -->
    <section class="slide" data-slide="2">
      <div class="slide-inner flex flex-col justify-center items-center text-center">
        <div class="text-4xl text-amber-400 mb-2"><i class="fa-solid fa-lightbulb"></i></div>
        <h2 class="text-xl sm:text-2xl font-bold text-white mb-2">Lý do chọn đề tài</h2>
        
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4 max-w-5xl w-full text-left">
          <!-- Card 1 -->
          <div class="glass-card p-5 rounded-2xl border-t-4 border-amber-400 flex flex-col justify-between">
            <div>
              <div class="flex items-center justify-between mb-3">
                <span class="badge-clean text-amber-300 border-amber-500/30"><i class="fa-solid fa-chart-line"></i> Bối cảnh ngành</span>
                <span class="hero-stat-number text-2xl text-amber-400">1.800+</span>
              </div>
              <h3 class="text-lg font-bold text-white mb-1.5">Quy mô chuỗi bùng nổ</h3>
              <p class="text-support">Mạng lưới nhà thuốc phủ khắp 63 tỉnh thành, áp lực vận hành đồng bộ chuỗi cung ứng, kho bãi và chuẩn GPP cực lớn.</p>
            </div>
            <div class="mt-4 pt-3 border-t border-white/10 flex items-center gap-2 text-xs font-semibold text-amber-300">
              <i class="fa-solid fa-arrow-trend-up"></i> Top 1 thị phần bán lẻ dược phẩm
            </div>
          </div>

          <!-- Card 2 -->
          <div class="glass-card p-5 rounded-2xl border-t-4 border-rose-400 flex flex-col justify-between">
            <div>
              <div class="flex items-center justify-between mb-3">
                <span class="badge-clean text-rose-300 border-rose-500/30"><i class="fa-solid fa-triangle-exclamation"></i> Thách thức lớn</span>
                <span class="hero-stat-number text-2xl text-rose-400">13.5p</span>
              </div>
              <h3 class="text-lg font-bold text-white mb-1.5">Nghẽn giờ cao điểm</h3>
              <p class="text-support">Thao tác thủ công, tra cứu kho chậm khiến khách chờ lâu; nguy cơ sai lệch tồn kho và thất thoát hàng cận hạn.</p>
            </div>
            <div class="mt-4 pt-3 border-t border-white/10 flex items-center gap-2 text-xs font-semibold text-rose-300">
              <i class="fa-solid fa-clock-rotate-left"></i> 44.4% thời gian quy trình là lãng phí (NVA)
            </div>
          </div>

          <!-- Card 3 -->
          <div class="glass-card p-5 rounded-2xl border-t-4 border-cyan-400 flex flex-col justify-between">
            <div>
              <div class="flex items-center justify-between mb-3">
                <span class="badge-clean text-cyan-300 border-cyan-500/30"><i class="fa-solid fa-laptop-code"></i> Giải pháp nhóm</span>
                <span class="hero-stat-number text-2xl text-cyan-400">-67%</span>
              </div>
              <h3 class="text-lg font-bold text-white mb-1.5">BPM & Số hóa TO-BE</h3>
              <p class="text-support">Mô hình hóa chuẩn BPMN 2.0, loại bỏ lãng phí Lean và xây dựng Website mô phỏng quy trình tương tác thực tiễn.</p>
            </div>
            <div class="mt-4 pt-3 border-t border-white/10 flex items-center gap-2 text-xs font-semibold text-cyan-300">
              <i class="fa-solid fa-circle-check"></i> Rút ngắn phục vụ xuống còn 4.5 phút
            </div>
          </div>
        </div>

        <!-- Takeaway Banner -->
        <div class="takeaway-bar amber w-full max-w-5xl">
          <i class="fa-solid fa-lightbulb text-amber-400 text-lg shrink-0"></i>
          <span class="text-xs sm:text-sm text-slate-200">
            <strong class="text-amber-300">Thông điệp cốt lõi:</strong> Áp dụng BPM giải quyết điểm nghẽn vận hành tại chuỗi bán lẻ dược lớn nhất Việt Nam, chuyển đổi từ quản lý thủ công sang quy trình số hóa chuẩn xác.
          </span>
        </div>
      </div>
    </section>

    <!-- SLIDE 3 -->

    <!-- SLIDE 3 -->

    <!-- SLIDE 3 -->
    <section class="slide" data-slide="3">
      <div class="slide-inner flex flex-col justify-center items-center text-center">
        <div class="text-4xl text-cyan-400 mb-2"><i class="fa-solid fa-bullseye"></i></div>
        <h2 class="text-xl sm:text-2xl font-bold text-white mb-2">Mục tiêu nghiên cứu</h2>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-4 max-w-5xl w-full text-left">
          <!-- Trọng tâm 1 -->
          <div class="glass-card p-5 rounded-2xl border-t-4 border-sky-400 flex flex-col justify-between">
            <div>
              <div class="flex items-center justify-between mb-2">
                <span class="badge-clean text-sky-300 border-sky-500/30">Trụ cột 1</span>
                <span class="text-xs font-mono font-bold text-sky-400">KHẢO SÁT AS-IS</span>
              </div>
              <h3 class="text-base font-bold text-white mb-2 flex items-center gap-2">
                <i class="fa-solid fa-sitemap text-sky-400"></i> Khảo sát & Mô hình hóa
              </h3>
              <ul class="space-y-2 text-support">
                <li class="flex items-start gap-2">
                  <i class="fa-solid fa-check text-sky-400 text-xs mt-1 shrink-0"></i>
                  <span>Khảo sát cơ cấu chuỗi <strong class="text-white">FPT Long Châu</strong>.</span>
                </li>
                <li class="flex items-start gap-2">
                  <i class="fa-solid fa-check text-sky-400 text-xs mt-1 shrink-0"></i>
                  <span>Phân loại <strong class="text-white">10 quy trình</strong> theo 3 tầng BPM.</span>
                </li>
                <li class="flex items-start gap-2">
                  <i class="fa-solid fa-check text-sky-400 text-xs mt-1 shrink-0"></i>
                  <span>Mô hình hóa <strong class="text-white">6 sơ đồ AS-IS</strong> chuẩn BPMN 2.0.</span>
                </li>
              </ul>
            </div>
            <div class="mt-4 pt-2.5 border-t border-white/10 text-xs font-bold text-sky-300 flex items-center gap-1.5">
              <i class="fa-solid fa-cube"></i> Đầu ra: Bộ sơ đồ BPMN AS-IS
            </div>
          </div>

          <!-- Trọng tâm 2 -->
          <div class="glass-card p-5 rounded-2xl border-t-4 border-amber-400 flex flex-col justify-between focal-card">
            <div>
              <div class="flex items-center justify-between mb-2">
                <span class="badge-clean text-amber-300 border-amber-500/30">Trụ cột 2</span>
                <span class="text-xs font-mono font-bold text-amber-400">PHÂN TÍCH SÂU</span>
              </div>
              <h3 class="text-base font-bold text-white mb-2 flex items-center gap-2">
                <i class="fa-solid fa-chart-pie text-amber-400"></i> Bóc tách Điểm nghẽn
              </h3>
              <ul class="space-y-2 text-support">
                <li class="flex items-start gap-2">
                  <i class="fa-solid fa-check text-amber-400 text-xs mt-1 shrink-0"></i>
                  <span>Khoan sâu 2 khâu: <strong class="text-white">Bán thuốc & Kho vận</strong>.</span>
                </li>
                <li class="flex items-start gap-2">
                  <i class="fa-solid fa-check text-amber-400 text-xs mt-1 shrink-0"></i>
                  <span>Định lượng chuỗi giá trị <strong class="text-white">VA / BVA / NVA</strong>.</span>
                </li>
                <li class="flex items-start gap-2">
                  <i class="fa-solid fa-check text-amber-400 text-xs mt-1 shrink-0"></i>
                  <span>Tìm căn nguyên bằng <strong class="text-white">5 Whys & Xương cá 6M</strong>.</span>
                </li>
              </ul>
            </div>
            <div class="mt-4 pt-2.5 border-t border-white/10 text-xs font-bold text-amber-300 flex items-center gap-1.5">
              <i class="fa-solid fa-magnifying-glass"></i> Đầu ra: Danh mục lãng phí & Root Causes
            </div>
          </div>

          <!-- Trọng tâm 3 -->
          <div class="glass-card p-5 rounded-2xl border-t-4 border-emerald-400 flex flex-col justify-between">
            <div>
              <div class="flex items-center justify-between mb-2">
                <span class="badge-clean text-emerald-300 border-emerald-500/30">Trụ cột 3</span>
                <span class="text-xs font-mono font-bold text-emerald-400">ỨNG DỤNG TO-BE</span>
              </div>
              <h3 class="text-base font-bold text-white mb-2 flex items-center gap-2">
                <i class="fa-solid fa-wand-magic-sparkles text-emerald-400"></i> Cải tiến & Demo Web
              </h3>
              <ul class="space-y-2 text-support">
                <li class="flex items-start gap-2">
                  <i class="fa-solid fa-check text-emerald-400 text-xs mt-1 shrink-0"></i>
                  <span>Thiết kế quy trình <strong class="text-white">BPMN TO-BE</strong> tối ưu.</span>
                </li>
                <li class="flex items-start gap-2">
                  <i class="fa-solid fa-check text-emerald-400 text-xs mt-1 shrink-0"></i>
                  <span>4 Đòn bẩy: <strong class="text-white">Barcode/QR, FEFO, WMS, AI</strong>.</span>
                </li>
                <li class="flex items-start gap-2">
                  <i class="fa-solid fa-check text-emerald-400 text-xs mt-1 shrink-0"></i>
                  <span>Xây dựng <strong class="text-white">Website SPA mô phỏng</strong> tương tác.</span>
                </li>
              </ul>
            </div>
            <div class="mt-4 pt-2.5 border-t border-white/10 text-xs font-bold text-emerald-300 flex items-center gap-1.5">
              <i class="fa-solid fa-globe"></i> Đầu ra: Mô hình TO-BE & Website Demo
            </div>
          </div>
        </div>

        <!-- Takeaway Banner -->
        <div class="takeaway-bar w-full max-w-5xl">
          <i class="fa-solid fa-bullseye text-cyan-400 text-lg shrink-0"></i>
          <span class="text-xs sm:text-sm text-slate-200">
            <strong class="text-cyan-300">Mục tiêu xuyên suốt:</strong> Hoàn thành trọn vẹn chu trình BPM (Khảo sát $\rightarrow$ Phân tích $\rightarrow$ Tối ưu hóa $\rightarrow$ Thực thi mô phỏng) gắn liền với bài toán thực tế của FPT Long Châu.
          </span>
        </div>
      </div>
    </section>

    <!-- SLIDE 4 -->

    <!-- SLIDE 4 -->

    <!-- SLIDE 4 -->
    <section class="slide" data-slide="4">
      <div class="slide-inner flex flex-col justify-center items-center text-center">
        <div class="text-4xl text-rose-400 mb-2"><i class="fa-solid fa-crosshairs"></i></div>
        <h2 class="text-xl sm:text-2xl font-bold text-white mb-2">Đối tượng & Phạm vi nghiên cứu</h2>
        
        <div class="max-w-5xl w-full text-left space-y-3.5">
          <!-- Đối tượng nghiên cứu: Focal Banner -->
          <div class="p-4 rounded-2xl bg-rose-500/15 border border-rose-500/40 text-slate-200 flex items-center justify-between">
            <div class="flex items-center gap-3">
              <div class="w-10 h-10 rounded-xl bg-rose-500/25 text-rose-400 flex items-center justify-center font-bold text-lg shrink-0">
                <i class="fa-solid fa-bullseye"></i>
              </div>
              <div>
                <span class="text-xs font-bold text-rose-300 uppercase tracking-wider block">Đối tượng nghiên cứu trọng tâm</span>
